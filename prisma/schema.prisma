// Esquema de Prisma para ObraApp
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL con pooling (pgBouncer) para la app en runtime.
  url       = env("DATABASE_URL")
  // URL de conexión directa para migraciones.
  directUrl = env("DIRECT_URL")
}

// Rubros (categorías de oficio) admitidos. El enum garantiza que la base
// solo acepte estos valores.
enum Categoria {
  plomeria
  gas
  albanileria
  pintura
}

// ----------------------------------------------------------------------------
// Autenticación (NextAuth + Prisma Adapter)
// ----------------------------------------------------------------------------

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  // Contraseña hasheada con bcrypt. Opcional: los usuarios de Google no tienen.
  hashedPassword     String?
  // Plan comercial: "free" | "pro".
  plan               String             @default("free")
  // Vencimiento del plan Pro (null si es Free o sin vencimiento).
  planExpiresAt      DateTime?
  // Onboarding completado (nombre + país).
  onboardingComplete Boolean            @default(false)
  // País del usuario (Argentina por defecto en el onboarding).
  country            String?
  createdAt          DateTime           @default(now())
  accounts           Account[]
  sessions           Session[]
  presupuestos       Presupuesto[]
  clientes           Cliente[]
  materiales         Material[]
  turnos             Turno[]
  tareas             TareaComunitaria[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Dominio de negocio: presupuestos
// ----------------------------------------------------------------------------

model Presupuesto {
  id            String            @id @default(cuid())
  numero        Int
  titulo        String
  clienteNombre String
  clienteEmail  String?
  clienteTel    String?
  // Estado: borrador | enviado | firmado | cancelado
  estado        String            @default("borrador")
  total         Float             @default(0)
  notas         String?
  // Presupuesto de ejemplo sembrado en el onboarding: no cuenta para el
  // límite del plan Free y no se puede descargar en PDF.
  esEjemplo     Boolean           @default(false)
  tokenFirma    String?           @unique
  firmadoAt     DateTime?
  // IP del cliente registrada al momento de firmar.
  clienteIp     String?
  creadoAt      DateTime          @default(now())
  actualizadoAt DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ItemPresupuesto[]
  // Asociación OPCIONAL a un cliente. Los campos clienteNombre/Email/Tel se
  // mantienen como snapshot histórico aunque el cliente cambie o se elimine.
  clienteId     String?
  cliente       Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  turnos        Turno[]

  @@index([clienteId])
}

// Cliente del usuario. Un cliente puede tener varios presupuestos.
model Cliente {
  id            String        @id @default(cuid())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  notas         String?
  creadoAt      DateTime      @default(now())
  actualizadoAt DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  presupuestos  Presupuesto[]
  turnos        Turno[]

  @@index([userId])
}

model ItemPresupuesto {
  id             String      @id @default(cuid())
  descripcion    String
  cantidad       Float
  precioUnitario Float
  subtotal       Float
  categoria      Categoria
  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  // Asociación OPCIONAL a un material del inventario, para descontar stock
  // automáticamente al firmar el presupuesto. Ambos nullable: sin material el
  // ítem funciona exactamente igual que antes.
  materialId     String?
  material       Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  cantidadUsada  Float?

  @@index([materialId])
}

// ----------------------------------------------------------------------------
// Agenda de turnos
// ----------------------------------------------------------------------------

// Turno de la agenda del usuario. Puede estar suelto, con datos de cliente
// sueltos (snapshot, como Presupuesto), y/o asociado a un Cliente o a un
// Presupuesto existentes. Sin notificaciones por ahora (iteración futura).
model Turno {
  id            String       @id @default(cuid())
  titulo        String
  // Estado: pendiente | confirmado | completado | cancelado
  estado        String       @default("pendiente")
  // Inicio del turno (fecha y hora).
  fecha         DateTime
  // Fin opcional del turno. Null = sin hora de fin definida.
  fechaFin      DateTime?
  notas         String?
  // Snapshot suelto del cliente (editable, opcional — turno sin cliente OK).
  clienteNombre String?
  clienteEmail  String?
  clienteTel    String?
  creadoAt      DateTime     @default(now())
  actualizadoAt DateTime     @updatedAt
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)

  @@index([userId, fecha])
}

// ----------------------------------------------------------------------------
// Inventario de materiales
// ----------------------------------------------------------------------------

// Material del inventario del usuario. El stock se ajusta manualmente y,
// además, se descuenta automáticamente al FIRMAR un presupuesto que tenga
// ítems con este material asociado (ver firmarPresupuesto).
model Material {
  id            String            @id @default(cuid())
  nombre        String
  categoria     Categoria
  // Unidad de medida: unidad, metro, litro, kg, etc.
  unidad        String
  stockActual   Float             @default(0)
  stockMinimo   Float             @default(0)
  creadoAt      DateTime          @default(now())
  actualizadoAt DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ítems de presupuesto que consumen este material (deducción automática).
  itemsUsados   ItemPresupuesto[]

  @@index([userId, categoria])
}

// ----------------------------------------------------------------------------
// Catálogo comunitario de tareas de referencia
// ----------------------------------------------------------------------------

model TareaComunitaria {
  id          String    @id @default(cuid())
  descripcion String
  // Unidad: hora, m2, m lineal, unidad, etc.
  unidad      String
  precioRef   Float?
  categoria   Categoria
  activa      Boolean   @default(true)
  creadoAt    DateTime  @default(now())
  // Dueño de la tarea. null = comunitaria/global (las 20 del seed, visibles
  // para todos); con valor = tarea PROPIA, visible solo para ese usuario.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Banners de afiliados
// ----------------------------------------------------------------------------

// Banner publicitario de un programa de afiliados. Es contenido GLOBAL,
// gestionado solo por el admin (no pertenece a un usuario). Se muestra a los
// usuarios filtrado por rubro. Sin tracking de clicks por ahora.
model BannerAfiliado {
  id          String     @id @default(cuid())
  titulo      String
  // URL externa de la imagen del banner (sin upload de archivos por ahora).
  imagenUrl   String
  // URL de destino del afiliado (se abre en pestaña nueva).
  linkDestino String
  // Rubro del banner. null = genérico (aplica a todos los rubros).
  categoria   Categoria?
  activo      Boolean    @default(true)
  // Prioridad de aparición cuando hay varios (menor = primero).
  orden       Int        @default(0)
  creadoAt    DateTime   @default(now())

  @@index([activo, categoria, orden])
}
