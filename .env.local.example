# ==============================================================================
# ObraApp — Plantilla de variables de entorno
# ==============================================================================
# Copiá este archivo a .env.local y completá cada valor.
# NUNCA subas .env.local ni .env al repositorio (ya están en .gitignore).
# Los valores acá quedan VACÍOS a propósito: cargá los tuyos localmente.
# ==============================================================================

# --- Base de datos (Supabase PostgreSQL) ---
# Connection pooling (pgBouncer) para la app en runtime.
DATABASE_URL=
# Conexión directa (sin pooling) para migraciones de Prisma.
DIRECT_URL=

# --- NextAuth ---
# Generá un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública de la app (ej: http://localhost:3000 en desarrollo).
NEXTAUTH_URL=

# --- Lemon Squeezy (suscripciones / pagos internacionales) ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- Mercado Pago (pagos LATAM) ---
MP_ACCESS_TOKEN=

# --- Resend (envío de emails) ---
RESEND_API_KEY=

# --- Redis (ioredis) ---
REDIS_URL=
