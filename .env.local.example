# ==============================================================================
# ObraApp — Plantilla de variables de entorno
# ==============================================================================
# Copiá este archivo a .env.local y completá cada valor.
# NUNCA subas .env.local ni .env al repositorio (ya están en .gitignore).
# Los valores acá quedan VACÍOS a propósito: cargá los tuyos localmente.
# Para el detalle de dónde obtener cada uno, mirá CREDENCIALES.md.
# ==============================================================================

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=
DIRECT_URL=

# --- NextAuth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Panel de administración ---
# Email autorizado a entrar a /admin (se verifica contra la BD en cada request).
ADMIN_EMAIL=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Lemon Squeezy (pagos internacionales) ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- Mercado Pago (pagos LATAM) ---
MP_ACCESS_TOKEN=

# --- Resend (envío de emails) ---
RESEND_API_KEY=

# --- Redis (ioredis / rate limiting) ---
REDIS_URL=
